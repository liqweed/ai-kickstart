// Cloudflare Workers static assets: serves dist/ as-is (no Worker code).
// Deploy: `pnpm run deploy` from the repo root (see docs/MAINTAINING.md). `cf` handles the account side
// (zone, DNS, domain); its own project build is still beta and doesn't support this static site yet.
// account_id is pinned so a deploy can never land in another Cloudflare account.
{
  "name": "ai-kickstart-site",
  "account_id": "f6e4f459077318abb757df718a57b37b",
  "compatibility_date": "2026-10-01",
  "send_metrics": false,
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "ai-kickstart.me", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "force-trailing-slash"
  }
}
