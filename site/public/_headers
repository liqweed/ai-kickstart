# Cloudflare static-asset headers. The page CSP (script/style hashes) is a <meta> tag Astro writes;
# frame-ancestors only works as a header, so it lives here.
/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Production serves these without a charset (unlike `wrangler dev`), so browsers would garble “quotes” and emoji.
/llms.txt
  Content-Type: text/plain; charset=utf-8

/*.md
  Content-Type: text/markdown; charset=utf-8
