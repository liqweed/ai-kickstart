{
  "name": "ai-kickstart",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "pnpm --filter site dev",
    "build": "pnpm --filter site build",
    "test": "pnpm --filter @ai-kickstart/core test",
    "check": "pnpm --filter site check",
    "deploy": "pnpm build && python3 scripts/check_site.py && pnpm --filter site run deploy"
  }
}
