filters:
  and:
    - file.ext == "md"
    - '!file.inFolder("_system")'
    - 'type == "person"'
views:
  - type: table
    name: By relationship
    groupBy:
      property: note.relationship
      direction: ASC
    order:
      - file.name
      - note.birthday
      - note.summary
      - note.updated
